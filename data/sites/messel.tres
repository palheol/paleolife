[resource]
script = ExtResource("1")
id = "messel"
site_name = "Fosse de Messel"
region = "Hesse, Allemagne"
formation = "Schistes bitumineux de Messel (Grube Messel)"
era_label = "Éocène (environ 47 millions d'années)"
