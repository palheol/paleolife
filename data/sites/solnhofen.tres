[resource]
script = ExtResource("1")
id = "solnhofen"
site_name = "Calcaires de Solnhofen"
region = "Bavière, Allemagne"
formation = "Plattenkalk de Solnhofen"
era_label = "Jurassique supérieur (environ 150 millions d'années)"
